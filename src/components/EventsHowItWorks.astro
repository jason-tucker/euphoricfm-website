---
// /events page — 3-step process card. Step numbers are decorative
// (.efm-step-num, global.css) so the list is a plain <ol> underneath for
// assistive tech.
import { site } from '../site.config';
const s = site.events.howItWorks;
---

<section class="section">
  <div class="card">
    <h2 class="text-base lg:text-xl font-bold tracking-wide text-sunburst">{s.title}</h2>
    <ol class="mt-3 space-y-3">
      {s.steps.map((step) => (
        <li class="flex gap-3">
          <span class="efm-step-num" aria-hidden="true">{step.n}</span>
          <div class="min-w-0">
            <h3 class="text-sm font-bold text-cream">{step.title}</h3>
            <p class="mt-0.5 text-sm text-cream/70 leading-relaxed">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
