---
// Site footer (Release 4): brand + blurb, four link columns (Listen / Station /
// Music / Contact), the Effects switch and the release link. Links that open
// a pop-up on the home page carry data-open (ModalControls.astro) and fall
// back to their href elsewhere. No Discord, by owner decision.
import nav from '../../shared/nav.json';
import { VERSION, SHORT_SHA } from '../lib/version';
import { site } from '../site.config';
const year = new Date().getFullYear();
const releaseUrl = `https://github.com/jason-tucker/euphoricfm-website/releases/tag/v${VERSION}`;
const f = site.home.footer;
const portal = (path: string) => nav.origins.portal + path;
type L = { label: string; href: string; open?: string };
const cols: [string, L[]][] = [
  [f.listen, [
    { label: 'Live player', href: '/#listen' },
    { label: 'Web Player', href: '/player/' },
    { label: 'Request a song', href: '/#listen', open: 'request' },
    { label: 'Ways to listen', href: '/#ways' },
  ]],
  [f.station, [
    { label: 'About', href: '/#about' },
    { label: 'Events', href: '/events/' },
    { label: 'Station stats', href: '/#stats' },
    { label: 'FAQ', href: '/#faq' },
  ]],
  [f.music, [
    { label: 'Submit music', href: portal(nav.musicMenu.submit.path) },
    { label: 'My music', href: portal('/dashboard') },
    { label: 'Fix or remove a song', href: portal('/library?intent=edit') },
    { label: 'How submitting works', href: portal('/') },
  ]],
  [f.contact, [
    { label: 'Contact us', href: '/#contact', open: 'contact' },
    { label: 'Advertise', href: '/#advertise', open: 'business' },
    { label: 'Plan an event', href: '/events/', open: 'event-inquiry' },
  ]],
];
---

<footer class="efmf">
  <div class="efmf-in">
    <div class="efmf-top">
      <div>
        <a class="efmf-brand" href="/" aria-label={`${site.name} home`}><span class="efmf-euph">Euphoric</span><span class="efmf-fm">FM</span></a>
        <p class="efmf-blurb">{f.blurb}</p>
      </div>
      <div class="efmf-cols">
        {cols.map(([title, links]) => (
          <nav aria-label={title}>
            <h2 class="efmf-h">{title}</h2>
            <ul>
              {links.map((l) => <li><a href={l.href} data-open={l.open}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="efmf-bot">
      <span>&copy; {year} {site.name}</span>
      <!-- Effects master switch. Wired by effects.ts, which also sets the correct
           aria-checked on load (it lives in client localStorage, so we can't render
           the true state server-side — it self-corrects right after hydration). -->
      <button
        id="efm-fx-toggle"
        type="button"
        role="switch"
        aria-checked="true"
        aria-label="Toggle visual effects"
        class="efm-fx-toggle"
      >
        <span class="efm-fx-track"><span class="efm-fx-thumb"></span></span>
        <span>Effects</span>
      </button>
      <a class="efmf-ver" href={releaseUrl} target="_blank" rel="noopener">v{VERSION} · {SHORT_SHA}</a>
    </div>
  </div>
</footer>

<style>
  .efmf {
    position: relative;
    z-index: 1;
    margin-top: 4rem;
    border-top: 1px solid rgb(var(--efm-cream-rgb) / 0.1);
    background: rgb(var(--efm-ink-rgb) / 0.85);
  }
  .efmf-in {
    max-width: var(--efmh-max, 72rem);
    margin: 0 auto;
    padding: 2.5rem var(--efmh-gutter, 16px) 1.75rem;
  }
  .efmf-top { display: grid; gap: 1.75rem; }
  @media (min-width: 900px) { .efmf-top { grid-template-columns: 1.3fr 4fr; } }
  .efmf-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  @media (min-width: 900px) { .efmf-cols { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .efmf-brand { display: inline-flex; align-items: baseline; text-decoration: none; }
  .efmf-euph { font-family: 'Begaron', system-ui, sans-serif; text-transform: uppercase; color: rgb(var(--efm-sunburst-rgb)); font-size: 1.25rem; line-height: 1; }
  .efmf-fm { font-family: 'Cortado Script', cursive; color: rgb(var(--efm-ruby-rgb)); font-size: 1.5rem; line-height: 1; margin-left: 1px; }
  .efmf-blurb { margin-top: 0.5rem; max-width: 22rem; font-size: 0.875rem; color: rgb(var(--efm-cream-rgb) / 0.7); }
  .efmf-h { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(var(--efm-cream-rgb) / 0.52); margin-bottom: 0.5rem; }
  .efmf ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.125rem; }
  .efmf li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: rgb(var(--efm-sunburst-rgb));
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .efmf li a:hover { color: rgb(var(--efm-gold-rgb)); text-decoration: underline; text-underline-offset: 3px; }
  .efmf-bot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--efm-cream-rgb) / 0.08);
    font-size: 0.8125rem;
    color: rgb(var(--efm-cream-rgb) / 0.52);
  }
  .efmf-ver {
    color: rgb(var(--efm-sunburst-rgb) / 0.85);
    text-decoration: underline;
    text-decoration-color: rgb(var(--efm-sunburst-rgb) / 0.4);
    text-underline-offset: 3px;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
  }
  .efmf-ver:hover { color: rgb(var(--efm-gold-rgb)); }
  .efm-fx-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;          /* tap target (CLAUDE rule 6) */
    padding: 0 0.5rem;
    border-radius: 9999px;
    color: inherit;
    font: inherit;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms ease;
  }
  @media (hover: hover) {
    .efm-fx-toggle:hover { color: rgb(var(--efm-cream-rgb) / 0.7); }
  }
  .efm-fx-track {
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 9999px;
    background: rgb(var(--efm-cream-rgb) / 0.15);
    transition: background 200ms ease;
    flex-shrink: 0;
  }
  .efm-fx-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    background: rgb(var(--efm-cream-rgb) / 0.55);
    transition: transform 200ms ease, background 200ms ease;
  }
  /* ON state — brand-coloured track + thumb slid right. */
  .efm-fx-toggle[aria-checked='true'] .efm-fx-track {
    background: linear-gradient(to right, rgb(var(--efm-sunburst-rgb)), rgb(var(--efm-ruby-rgb)));
  }
  .efm-fx-toggle[aria-checked='true'] .efm-fx-thumb {
    transform: translateX(14px);
    background: rgb(var(--efm-ink-rgb));
  }
  .efm-fx-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(var(--efm-sunburst-rgb) / 0.6);
  }
</style>
