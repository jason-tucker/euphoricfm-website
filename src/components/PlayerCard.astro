---
import { site } from '../site.config';
const un = site.home.upNext;
---

<!-- Unified player: now-playing + transport controls + visualizer + up-next.
     The script below wires the transport to stream-audio.ts, which owns the
     audio element + Web Audio analyser and writes --efm-bass / --efm-mid /
     --efm-high / --efm-energy CSS variables on :root every frame so anything
     on the page can react to the music. -->
<section class="pt-2">
  <!-- No overflow-hidden here: the bass halo lives on #np-card::before and its
       box-shadow paints OUTSIDE the card box — an ancestor clip would erase it.
       Children that need clipping (#np-up-next, the progress track) clip themselves. -->
  <div id="np-card" class="card bg-midnight/40 border-midnight/40 relative" data-offline={site.player.offline}>

    <!-- Special-event banner — slides open when a live DJ connects
         (data.live.is_live from AzuraCast; live sets are always special events
         for this station). Same max-height+opacity reveal as #np-up-next, so
         it's CEF-safe. The streamer name is remote data: nowplaying.ts writes
         it via textContent only. No margin on the wrapper — the inner mb-3 is
         contained by overflow-hidden, so the collapsed state costs zero space. -->
    <div id="np-live-banner" aria-hidden="true" class="overflow-hidden max-h-0 opacity-0 transition-[max-height,opacity] duration-500 ease-out">
      <div class="mb-3 rounded-xl border border-ruby/40 bg-ruby/15 px-3 py-2.5 flex items-center gap-2.5">
        <span class="relative flex w-2.5 h-2.5 shrink-0">
          <span class="absolute inset-0 rounded-full bg-ruby animate-soft-pulse"></span>
          <span class="relative rounded-full w-2.5 h-2.5 bg-ruby"></span>
        </span>
        <div class="min-w-0 flex-1">
          <div class="text-[10px] font-bold uppercase tracking-widest text-gold">{site.liveEvents.eyebrow}</div>
          <div id="np-live-streamer" class="truncate text-sm font-bold text-cream"></div>
          <div class="truncate text-[11px] text-cream/70">{site.liveEvents.tagline}</div>
        </div>
      </div>
    </div>

    <!-- Top row: artwork + track info + transport stack. Layout:
           [art] [LIVE/Now Playing/title/artist/album] [PLAY button stacked over VOL slider]
         The separate "Stream / Streaming live" transport row beneath the
         progress bar is gone — the LIVE pill above already signals state. -->
    <div class="flex items-start" style="gap: clamp(0.75rem, 1.5vw, 1.25rem);">
      <div class="relative shrink-0">
        <img
          id="np-art"
          src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'/%3E"
          alt=""
          class="rounded-lg object-cover bg-cream/10 shadow-xl block"
          style="width: clamp(5rem, 14vw, 10rem); height: clamp(5rem, 14vw, 10rem);"
        />
        <div class="absolute inset-0 rounded-lg pointer-events-none ring-1 ring-inset ring-cream/10"></div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 mb-1 flex-wrap">
          <!-- The label lives in its own span so nowplaying.ts can retext it
               without wiping the dot (assigning textContent on the pill itself
               destroyed #np-live-dot — the pre-0.12.0 bug). No `inline-block`
               on the dot: it would out-specificity the `hidden` toggle under
               Tailwind v4's utility order (same trap as the 0.11.1 badges). -->
          <span id="np-status" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold tracking-widest bg-ruby/20 text-ruby">
            <span id="np-live-dot" class="w-1.5 h-1.5 rounded-full bg-ruby"></span><span id="np-status-text">{site.liveEvents.idlePill}</span>
          </span>
          <span id="np-eyebrow" class="text-[10px] uppercase tracking-widest text-cream/40">Now Playing</span>
          <!-- Shown by nowplaying.ts when now_playing.is_request === true. -->
          <span id="np-requested" class="hidden rounded-full px-2 py-0.5 text-[10px] font-bold tracking-widest bg-sunburst/25 text-sunburst">REQUESTED</span>
        </div>
        <div id="np-title" class="truncate font-bold text-cream" style="font-size: clamp(1rem, 1.8vw, 1.375rem);">Loading…</div>
        <div id="np-artist" class="truncate text-cream/75" style="font-size: clamp(0.875rem, 1.3vw, 1.0625rem);">—</div>
        <div id="np-album" class="truncate text-cream/45 mt-0.5 min-h-[1.3em]" style="font-size: clamp(0.75rem, 1.1vw, 0.9375rem);"></div>
      </div>

      <!-- Transport stack — play button over volume slider, top-right of the
           card. Width clamps so the title block isn't squeezed on a 360px
           in-game phone iframe. -->
      <div class="efm-js-only shrink-0 flex flex-col items-end" style="gap: clamp(0.5rem, 0.8vw, 0.625rem); width: clamp(3rem, 8vw, 5rem);">
        <button
          id="efm-play"
          type="button"
          class="inline-flex items-center justify-center rounded-full bg-sunburst text-ink shadow-lg active:scale-95 transition-transform"
          style="width: clamp(3rem, 4.5vw, 3.75rem); height: clamp(3rem, 4.5vw, 3.75rem);"
          aria-label="Play"
        >
          <svg id="efm-play-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5" style="width: clamp(1.5rem, 2vw, 1.875rem); height: clamp(1.5rem, 2vw, 1.875rem);"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <input
          id="efm-volume"
          type="range"
          min="0"
          max="100"
          value="80"
          aria-label="Volume"
          class="efm-range w-full"
        />
        <audio id="efm-audio" preload="none" crossorigin="anonymous"></audio>
      </div>
    </div>

    <noscript>
      <p class="mt-3 text-xs text-cream/70">The player needs JavaScript. You can still listen: <a class="underline text-sunburst" href="#ways">open the stream in your music app</a>.</p>
    </noscript>

    <!-- Progress bar + times. Bar shimmers with mid frequencies when playing. -->
    <div style="margin-top: clamp(0.75rem, 1.2vw, 1rem);">
      <div id="np-bar-track" class="w-full rounded-full bg-cream/10 overflow-hidden relative" style="height: clamp(0.375rem, 0.5vw, 0.5rem);">
        <div id="np-bar" class="h-full bg-gradient-to-r from-sunburst to-gold transition-[width] duration-300" style="width: 0%"></div>
      </div>
      <div class="mt-1.5 flex items-center justify-between text-cream/60" style="font-size: clamp(0.625rem, 0.85vw, 0.75rem);">
        <span id="np-times">0:00 / 0:00</span>
        <span><span id="np-listeners">0</span> listening</span>
      </div>
    </div>

    <!-- Up Next. One fixed-height row (nothing below it ever moves) that
         shows the next song for the whole of the current one — AzuraCast
         cues playing_next when a song starts. When there is no song to show
         (not known yet, an ad/station ID is next, a live set is on) the note
         layer says so instead; nowplaying.ts cross-fades the two via .is-open
         and retexts the note from the data-* copy below. -->
    <div
      id="np-up-next"
      class="mt-3 border-t border-cream/10 pt-3"
      data-choosing={un.choosing}
      data-break={un.stationBreak}
      data-live={un.live}
      data-offline={un.offline}
      data-exclude={JSON.stringify(site.player.excludePlaylists)}
    >
      <div class="np-un-wait flex items-center gap-3">
        <div class="text-[10px] uppercase tracking-widest text-cream/45 shrink-0">{un.label}</div>
        <div class="w-9 h-9 rounded-md border border-dashed border-cream/15 shrink-0" aria-hidden="true"></div>
        <div id="up-next-note" class="min-w-0 flex-1 truncate text-[11px] lg:text-xs text-cream/55">{un.choosing}</div>
      </div>
      <div class="np-un-track flex items-center gap-3">
        <div class="text-[10px] uppercase tracking-widest text-cream/45 shrink-0">{un.label}</div>
        <img id="up-next-art" src="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'/%3E" alt="" class="w-9 h-9 rounded-md object-cover bg-cream/10 shrink-0" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <div id="up-next-title" class="truncate text-xs lg:text-sm font-semibold text-cream">—</div>
            <!-- Shown by nowplaying.ts when playing_next.is_request === true. -->
            <span id="up-next-requested" class="hidden shrink-0 rounded-full px-1.5 py-px text-[9px] font-bold tracking-widest bg-sunburst/25 text-sunburst">REQUESTED</span>
          </div>
          <div id="up-next-artist" class="truncate text-[10px] lg:text-xs text-cream/60">—</div>
        </div>
        <!-- "in 2:41" countdown to the change, painted by the RAF loop. -->
        <div id="up-next-when" class="shrink-0 text-[10px] lg:text-xs tabular-nums text-cream/55"></div>
      </div>
    </div>

    <!-- Card actions (index.astro passes Request a song / Web Player / Ways
         to listen in here, so they sit with the player on the first screen). -->
    <slot />
  </div>
</section>

<style is:global>
  /* Up next — .is-open on #np-up-next (set by nowplaying.ts whenever the
     next song is known) shows the track layer; otherwise the note layer. The
     two share one grid cell in a fixed-height row and cross-fade, so nothing
     below the row moves when it switches. */
  /* minmax(0, 1fr): without an explicit column the implicit auto column grows
     to the track layer's min-content (the full title), so a long title never
     truncates and pushes the REQUESTED badge and the "in m:ss" countdown past
     the clipped edge. */
  #np-up-next { display: grid; grid-template-columns: minmax(0, 1fr); height: 50px; overflow: hidden; }
  #np-up-next > * { grid-area: 1 / 1; transition: opacity 500ms ease-out, visibility 500ms; }
  #np-up-next .np-un-track { opacity: 0; visibility: hidden; }
  #np-up-next.is-open .np-un-track { opacity: 1; visibility: visible; }
  #np-up-next.is-open .np-un-wait { opacity: 0; visibility: hidden; }

  /* Special-event banner reveal — same mechanism, driven by nowplaying.ts. */
  #np-live-banner.is-open {
    max-height: 96px;
    opacity: 1;
  }

  /* Custom range slider. The input itself is a 28px-tall hit area (the old
     4px-tall input with a 12px thumb was very hard to grab); the visible 5px
     track is painted by the track pseudo-elements. Cross-browser styling. */
  input.efm-range {
    -webkit-appearance: none;
    appearance: none;
    height: 28px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input.efm-range::-webkit-slider-runnable-track {
    height: 5px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      rgb(var(--efm-sunburst-rgb)) 0%,
      rgb(var(--efm-sunburst-rgb)) var(--vol, 80%),
      rgb(var(--efm-cream-rgb) / 0.16) var(--vol, 80%),
      rgb(var(--efm-cream-rgb) / 0.16) 100%
    );
  }
  input.efm-range::-moz-range-track {
    height: 5px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      rgb(var(--efm-sunburst-rgb)) 0%,
      rgb(var(--efm-sunburst-rgb)) var(--vol, 80%),
      rgb(var(--efm-cream-rgb) / 0.16) var(--vol, 80%),
      rgb(var(--efm-cream-rgb) / 0.16) 100%
    );
  }
  input.efm-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -6.5px;
    border-radius: 9999px;
    background: rgb(var(--efm-cream-rgb));
    border: 3px solid rgb(var(--efm-sunburst-rgb));
    box-shadow: 0 1px 4px rgb(var(--efm-ink-rgb) / 0.6);
    cursor: pointer;
  }
  input.efm-range::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: rgb(var(--efm-cream-rgb));
    border: 3px solid rgb(var(--efm-sunburst-rgb));
    cursor: pointer;
  }
  input.efm-range:focus-visible {
    outline: 2px solid rgb(var(--efm-sunburst-rgb));
    outline-offset: 2px;
    border-radius: 6px;
  }
</style>

<script>
  // Transport for the home player. The audio engine (play/stop, cache-busted
  // live src, Web Audio analyser writing the --efm-* reaction vars, effects
  // gating, Media Session bridge) lives in stream-audio.ts and is shared with
  // the Web Player at /player/.
  import { site } from '../site.config';
  import { createStreamEngine } from '../scripts/stream-audio';
  import { showToast } from '../scripts/toast';

  const audio = document.getElementById('efm-audio') as HTMLAudioElement | null;
  const btn = document.getElementById('efm-play');
  const icon = document.getElementById('efm-play-icon');
  const vol = document.getElementById('efm-volume') as HTMLInputElement | null;
  const card = document.getElementById('np-card');

  if (audio && btn && icon && vol) {
    const playIcon = '<path d="M8 5v14l11-7z"/>';
    const pauseIcon = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';
    audio.volume = Number(vol.value) / 100;
    vol.style.setProperty('--vol', vol.value + '%');

    const engine = createStreamEngine({
      audio,
      card,
      getStreamUrl: () => site.azuracast.streamUrl,
      onChange: (playing) => {
        icon.innerHTML = playing ? pauseIcon : playIcon;
        btn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      },
      onPlayError: () => showToast(site.player.playFailed),
    });

    btn.addEventListener('click', () => { void engine.toggle(); });
    vol.addEventListener('input', () => {
      audio.volume = Number(vol.value) / 100;
      vol.style.setProperty('--vol', vol.value + '%');
    });
  }
</script>
