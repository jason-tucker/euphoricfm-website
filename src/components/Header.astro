---
// The shared EuphoricFM top bar (Release 3). Same items, same markup and the
// same stylesheet as the music portal's bar (music/src/components/SiteBar.tsx):
// both render shared/nav.json with shared/efm-bar.css, and
// test/shared-drift.test.mjs fails if the two copies drift apart.
//
// Menus are <details>/<summary> so they work with JavaScript off (the in-game
// CEF browser); the script below only adds outside-click / Escape closing,
// opens the contact modal for "Contact" on the home page, and moves
// aria-current between the home page's sections.
import nav from '../../shared/nav.json';
import '../../shared/efm-bar.css';

type Link = { site?: string; path?: string };
interface Props {
  /** Top-bar item for this page: listen (home), events, player … */
  current?: 'listen' | 'about' | 'events' | 'stats' | 'contact' | 'player';
}
const { current } = Astro.props;

// On info.euphoric.fm, info paths stay relative; portal paths get the origin.
const href = (l: Link) => (l.site === 'portal' ? nav.origins.portal + l.path : l.path);
const icons = nav.icons as Record<string, string[]>;
const cur = (id: string) => (id === current ? 'page' : undefined);
const items = nav.items.filter((i) => !i.menu);
const menu = nav.musicMenu;
const sheetStation = [...items, nav.webPlayer];
---

<header class="efmh" data-efmh>
  <div class="efmh-in">
    <a class="efmh-brand" href={href(nav.brand)} aria-label={nav.brand.label}>
      <span class="efmh-euph">Euphoric</span><span class="efmh-fm">FM</span>
    </a>

    <nav class="efmh-nav" aria-label="EuphoricFM">
      <ul class="efmh-list">
        {nav.items.map((i) =>
          i.menu ? (
            <li>
              <details class="efmh-dd" data-efmh-menu>
                <summary class="efmh-link" data-efmh-id={i.id}>
                  {i.label}
                  <svg class="efmh-caret" viewBox="0 0 24 24" aria-hidden="true">{icons.caret!.map((d) => <path d={d} />)}</svg>
                </summary>
                <div class="efmh-menu">
                  <div class="efmh-menu-h">
                    <span class="efmh-menu-ic"><svg viewBox="0 0 24 24" aria-hidden="true">{icons.music!.map((d) => <path d={d} />)}</svg></span>
                    <span>
                      <span class="efmh-menu-t">{menu.title}</span>
                      <span class="efmh-menu-d">{menu.blurb}</span>
                    </span>
                  </div>
                  <a class="efmh-gold efmh-submit" href={href(menu.submit)}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">{icons.submit!.map((d) => <path d={d} />)}</svg>
                    {menu.submit.label}
                  </a>
                  <ul class="efmh-rows">
                    {menu.items.map((m) => (
                      <li>
                        <a class="efmh-mi" href={href(m)}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">{icons[m.id]!.map((d) => <path d={d} />)}</svg>
                          <span class="efmh-mi-txt"><span class="efmh-mi-t">{m.label}</span><span class="efmh-mi-d">{m.desc}</span></span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a class="efmh-link" href={href(i)} aria-current={cur(i.id)} data-efmh-id={i.id} data-efmh-contact={i.id === 'contact' ? '' : undefined}>
                {i.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <a class="efmh-gold efmh-player" href={href(nav.webPlayer)} aria-current={cur(nav.webPlayer.id)}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="efmh-fill" d={icons.play![0]} /></svg>
      {nav.webPlayer.label}
    </a>

    <details class="efmh-burger" data-efmh-menu>
      <summary aria-label={nav.sheet.open}>
        <svg class="efmh-m" viewBox="0 0 24 24" aria-hidden="true">{icons.menu!.map((d) => <path d={d} />)}</svg>
        <svg class="efmh-x" viewBox="0 0 24 24" aria-hidden="true">{icons.close!.map((d) => <path d={d} />)}</svg>
        <span class="efmh-lbl-open">{nav.sheet.open}</span><span class="efmh-lbl-close">{nav.sheet.close}</span>
      </summary>
      <div class="efmh-sheet">
        <div class="efmh-sheet-in">
          <section class="efmh-grp" aria-label={nav.sheet.stationHeading}>
            <h2 class="efmh-gh">{nav.sheet.stationHeading}</h2>
            <ul class="efmh-grid">
              {sheetStation.map((i) => (
                <li>
                  <a class="efmh-mi" href={href(i)} aria-current={cur(i.id)} data-efmh-id={i.id} data-efmh-contact={i.id === 'contact' ? '' : undefined}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">{icons[i.id]!.map((d) => <path d={d} />)}</svg>
                    <span class="efmh-mi-txt"><span class="efmh-mi-t">{i.label}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
          <section class="efmh-grp" aria-label={nav.sheet.musicHeading}>
            <h2 class="efmh-gh">{nav.sheet.musicHeading}</h2>
            <a class="efmh-gold efmh-submit" href={href(menu.submit)}>
              <svg viewBox="0 0 24 24" aria-hidden="true">{icons.submit!.map((d) => <path d={d} />)}</svg>
              {menu.submit.label}
            </a>
            <ul class="efmh-rows">
              {menu.items.map((m) => (
                <li>
                  <a class="efmh-mi" href={href(m)}>
                    <svg viewBox="0 0 24 24" aria-hidden="true">{icons[m.id]!.map((d) => <path d={d} />)}</svg>
                    <span class="efmh-mi-txt"><span class="efmh-mi-t">{m.label}</span><span class="efmh-mi-d">{m.desc}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // Enhancement only: every menu already works without this (details/summary).
  const menus = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('.efmh details[data-efmh-menu]'));
  const closeAll = (except?: Element) => menus().forEach((d) => { if (d !== except && d.open) d.open = false; });

  menus().forEach((d) => d.addEventListener('toggle', () => { if (d.open) closeAll(d); }));

  document.addEventListener('click', (e) => {
    const t = e.target as Element | null;
    if (!t || !t.closest) return;
    const inMenu = t.closest('.efmh details[data-efmh-menu]') as HTMLDetailsElement | null;
    closeAll(inMenu ?? undefined);
    // Following a link inside a menu (e.g. a same-page #section) closes it.
    if (inMenu && t.closest('a')) inMenu.open = false;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus().filter((d) => d.open);
    if (!open.length) return;
    closeAll();
    open[0]!.querySelector('summary')?.focus();
  });

  // "Contact" opens the existing contact modal on pages that have it (home);
  // elsewhere it is a plain link to /#contact, which opens the modal on arrival.
  const contactModal = () => document.getElementById('contact-overlay');
  const openContact = () => document.dispatchEvent(new CustomEvent('efm:open-contact'));
  document.querySelectorAll('.efmh [data-efmh-contact]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!contactModal()) return;
      e.preventDefault();
      closeAll();
      openContact();
    }),
  );
  if (location.hash === '#contact' && contactModal()) {
    if (document.readyState === 'complete') openContact();
    else window.addEventListener('load', openContact, { once: true });
  }

  // Home page: aria-current follows the section the visitor jumped to.
  const markHash = () => {
    const id = location.hash.slice(1);
    const links = Array.from(document.querySelectorAll<HTMLElement>('.efmh [data-efmh-id]'));
    if (!id || !document.getElementById(id) || !links.some((l) => l.getAttribute('href') === `/#${id}`)) return;
    links.forEach((l) => {
      if (l.getAttribute('href') === `/#${id}`) l.setAttribute('aria-current', 'location');
      else if (l.getAttribute('href')?.startsWith('/#')) l.removeAttribute('aria-current');
    });
  };
  window.addEventListener('hashchange', markHash);
  markHash();
</script>
