---
// Station Stats section (#stats on the one-page home). Markup skeleton only —
// every data-driven value (KPI numbers, chart SVGs, table rows, top lists,
// detail overlay content) is built by scripts/stats.ts, which stats-lazy.ts
// loads once the section nears the viewport. The skeleton is rendered at full
// size from the start (placeholder rows, fixed chart heights) so nothing below
// it moves when the data lands.
//
// Condensed by default: range tabs, 4 KPI tiles, the Listeners chart and the
// top 5 tracks and artists. "Show full stats" reveals #stats-full (Listens
// and Rhythm charts) and the longer top lists.
import { site } from '../site.config';
const s = site.stats;
const h = site.home.stats;
const kpis = [
  ['plays', s.kpi.plays.label],
  ['peak', s.kpi.peakListeners.label],
  ['tracks', s.kpi.tracks.label],
  ['requests', s.kpi.requests.label],
] as const;
const chevron = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
---

<section id="stats" class="hm-section" aria-labelledby="stats-h">
  <div class="hm-sec-head">
    <div>
      <p class="hm-eyebrow">{h.eyebrow}</p>
      <h2 id="stats-h" class="hm-h2">{h.heading}</h2>
      <p id="stats-coverage" class="hm-small hm-faint mt-1 min-h-[1.25rem]"></p>
    </div>
    <!-- Primary range row — the ONE synced selection that scopes the KPI grid,
         the Listeners/Listens charts and the top lists (stats.ts
         renderRangeTabs()/setRange()). JS-rendered only: coverage gates which
         presets exist. min-height reserves its row so nothing jumps. -->
    <div id="stats-range-tabs" class="hm-seg min-h-[48px]" role="group" aria-label={s.rangeAriaLabel}></div>
  </div>

  <p id="stats-unavailable" class="hidden hm-note">{h.unavailable}</p>

  <!-- 1. KPI tiles — 2×2 on phones, 4 across on desktop. -->
  <div class="hm-kpis">
    {kpis.map(([id, label]) => (
      <div class="hm-kpi">
        <div class="hm-kpi-k">{label}</div>
        <div id={`stats-kpi-${id}-value`} class="hm-kpi-v">—</div>
        <div id={`stats-kpi-${id}-sub`} class="hm-kpi-s"></div>
      </div>
    ))}
  </div>

  <div class="hm-stats-grid">
    <!-- 2. Listeners card. -->
    <div class="hm-surface">
      <h3 class="hm-h3">{s.listeners.title}</h3>
      <div id="stats-listeners-chart" class="efm-stats-chart mt-3" role="img" aria-label={s.listeners.ariaLabel}></div>
      <p id="stats-listeners-caption" class="mt-1 text-[11px] text-cream/40 min-h-[1rem]"></p>
      <details class="efm-stats-table mt-1">
        <summary>{s.viewTable}</summary>
        <div id="stats-listeners-table" class="efm-stats-table-scroll efm-sidebar-scroll"></div>
      </details>
    </div>

    <!-- 3. Top tracks — rows are bordered buttons with a chevron (48px+)
         that open the detail overlay. 5 rows condensed; 10 + Show more (up to
         25 for a ranged rollup, 50 for 'all') once the full stats are open. -->
    <div class="hm-surface">
      <h3 class="hm-h3">{s.topTracks.title}</h3>
      <p class="hm-tiny hm-faint">{h.topTracksHint} <span id="stats-top-tracks-sub"></span></p>
      <ul id="stats-top-tracks-list" class="hm-rows mt-3">
        {[0, 1, 2, 3, 4].map(() => <li class="efm-row-ph" aria-hidden="true"></li>)}
      </ul>
      <button type="button" id="stats-top-tracks-more" class="btn btn-ghost w-full mt-3 hidden">{s.showMore}</button>
    </div>

    <!-- 4. Top artists — same pattern, drills into the artist detail view. -->
    <div class="hm-surface">
      <h3 class="hm-h3">{s.topArtists.title}</h3>
      <p class="hm-tiny hm-faint">{h.topArtistsHint} <span id="stats-top-artists-sub"></span></p>
      <ul id="stats-top-artists-list" class="hm-rows mt-3">
        {[0, 1, 2, 3, 4].map(() => <li class="efm-row-ph" aria-hidden="true"></li>)}
      </ul>
      <button type="button" id="stats-top-artists-more" class="btn btn-ghost w-full mt-3 hidden">{s.showMore}</button>
    </div>
  </div>

  <div class="flex justify-center mt-5">
    <button
      type="button"
      id="stats-full-toggle"
      class="btn btn-ghost"
      aria-expanded="false"
      aria-controls="stats-full"
      data-show={h.showFull}
      data-hide={h.hideFull}
    ><span id="stats-full-label">{h.showFull}</span><span class="hm-caret" set:html={chevron} /></button>
  </div>

  <div id="stats-full" class="hidden">
    <div class="hm-stats-full">
      <!-- 5. Listens card (listener-weighted plays, ids keep "plays");
           #stats-plays-sub flips between "per day"/"per week". -->
      <div class="hm-surface">
        <h3 class="hm-h3">{s.plays.title}</h3>
        <div id="stats-plays-tabs" class="mt-2 flex flex-wrap gap-2" role="group" aria-label={s.plays.ariaLabel}></div>
        <p id="stats-plays-sub" class="mt-1 text-[11px] text-cream/45"></p>
        <div id="stats-plays-chart" class="efm-stats-chart mt-2" role="img" aria-label={s.plays.ariaLabel}></div>
        <p id="stats-plays-caption" class="mt-1 text-[11px] text-cream/40"></p>
        <details class="efm-stats-table mt-1">
          <summary>{s.viewTable}</summary>
          <div id="stats-plays-table" class="efm-stats-table-scroll efm-sidebar-scroll"></div>
        </details>
      </div>

      <!-- 6. Rhythm card — 7×24 day×hour heatmap, all-time (not synced to
           the range above). Basis tabs pick listens vs. avg listeners. -->
      <div class="hm-surface">
        <h3 class="hm-h3">{s.rhythm.title}</h3>
        <div id="stats-rhythm-tabs" class="mt-2 flex flex-wrap gap-2" role="group" aria-label={s.rhythm.ariaLabel}>
          {Object.entries(s.rhythm.tabs).map(([key, label]) => (
            <button type="button" class="efm-stats-tab" data-basis={key} aria-pressed="false">{label}</button>
          ))}
        </div>
        <p id="stats-rhythm-sub" class="mt-1 text-[11px] text-cream/45"></p>
        <div id="stats-rhythm-chart" class="relative mt-3" role="img" aria-label={s.rhythm.ariaLabel}></div>
        <p id="stats-rhythm-caption" class="mt-1 text-[11px] text-cream/40"></p>
        <details class="efm-stats-table mt-1">
          <summary>{s.viewTable}</summary>
          <div id="stats-rhythm-table" class="efm-stats-table-scroll efm-sidebar-scroll"></div>
        </details>
      </div>
    </div>
  </div>
</section>
