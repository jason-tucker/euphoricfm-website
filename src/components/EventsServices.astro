---
// /events page — services grid + "Good for" chips. Kept as one file per the
// spec: the chips block is small enough that splitting it out would just add
// an import for no reuse benefit.
import { site } from '../site.config';
const svc = site.events.services;
const good = site.events.goodFor;
---

<section class="section">
  <div class="card">
    <h2 class="text-base lg:text-xl font-bold tracking-wide text-sunburst">{svc.title}</h2>
    <div class="mt-3 grid gap-2.5 sm:grid-cols-2">
      {svc.items.map((item) => (
        <div class="rounded-xl border border-cream/10 bg-cream/[0.03] p-3">
          <h3 class="text-sm font-bold text-cream">{item.title}</h3>
          <p class="mt-1 text-xs text-cream/65 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>

    <h3 class="mt-4 text-xs font-bold tracking-[0.2em] uppercase text-cream/65">{good.title}</h3>
    <div class="mt-2 flex flex-wrap gap-2">
      {good.items.map((label) => (
        <span class="efm-chip">{label}</span>
      ))}
    </div>
  </div>
</section>
