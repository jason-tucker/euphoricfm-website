---
// Recently played — the top card of the hero's side column. The list is
// filled by nowplaying.ts (applyRecent renders five rows); five placeholder
// rows of the same height hold the space until then, so nothing below moves
// when the history arrives. "Song history" opens the Web Player's full list.
import { site } from '../site.config';
const r = site.home.recent;
---

<section class="efm-sidebar-section hm-side-card" aria-labelledby="recent-h">
  <div class="hm-surface hm-side-surface efm-sidebar-card">
    <div class="hm-side-h">
      <h2 id="recent-h" class="hm-h3">{r.title}</h2>
      <a href="/player/#history" class="btn btn-ghost btn-sm">{r.history}<span class="hm-chev" aria-hidden="true">›</span></a>
    </div>
    <ul id="recent-list" class="divide-y divide-cream/5 efm-sidebar-scroll">
      {[0, 1, 2, 3, 4].map((i) => (
        <li class="flex items-center gap-3 py-2 border-t border-cream/5 first:border-t-0" aria-hidden={i > 0 ? 'true' : undefined}>
          <div class="w-10 h-10 rounded-md bg-cream/10 shrink-0"></div>
          <div class="min-w-0 flex-1">
            {i === 0 ? (
              <div class="truncate text-sm text-cream/40">Loading recent tracks…</div>
            ) : (
              <div class="h-5 flex items-center"><div class="h-2.5 w-2/3 rounded bg-cream/10"></div></div>
            )}
            <div class="h-4 flex items-center"><div class="h-2 w-1/3 rounded bg-cream/5"></div></div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
