---
// Empty list — populated by nowplaying.ts. In the 2-column hero layout this
// becomes the top half of the sidebar; height is no longer capped at a hard
// 520px — `.efm-sidebar`/`.efm-sidebar-section` (global.css) make the
// sidebar stretch to match player+buttons and split between this card and
// the Your-Requests card below.
---

<section class="efm-sidebar-section pt-2">
  <div class="card !py-3 efm-sidebar-card">
    <h2 class="text-xs font-bold tracking-[0.2em] uppercase text-cream/65 mb-1 lg:mb-2 shrink-0">Recently Played</h2>
    <!-- Five placeholder rows the same height as the real ones (nowplaying.ts
         applyRecent renders five), so the list does not push the page down
         when the history arrives. That late push was the home page's biggest
         layout shift on phones and moved /#about and /#stats after a jump. -->
    <ul id="recent-list" class="divide-y divide-cream/5 efm-sidebar-scroll">
      {[0, 1, 2, 3, 4].map((i) => (
        <li class="flex items-center gap-3 py-2 border-t border-cream/5 first:border-t-0" aria-hidden={i > 0 ? 'true' : undefined}>
          <div class="w-10 h-10 rounded-md bg-cream/10 shrink-0"></div>
          <div class="min-w-0 flex-1">
            {i === 0 ? (
              <div class="truncate text-sm text-cream/40">Loading recent tracks…</div>
            ) : (
              <div class="h-5 flex items-center"><div class="h-2.5 w-2/3 rounded bg-cream/10"></div></div>
            )}
            <div class="h-4 flex items-center"><div class="h-2 w-1/3 rounded bg-cream/5"></div></div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
