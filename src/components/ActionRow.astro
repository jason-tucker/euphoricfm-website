---
// Six-button action row: Request, Web Player, Submit music, Events, Contact,
// Business AD. "Web Player" is a plain link to /player/ (temporary home for it
// until the shared site header lands).
// Click handlers dispatch CustomEvents that the modal components listen for.
// Uses View Transitions API for smooth modal open if supported. "Events" is
// plain navigation (no CustomEvent, no modal) — it links to /events, whose
// own EventInquiryModal handles the "Plan Your Event" flow independently.
// "Submit music" is plain navigation too: it opens the music portal
// (music.euphoric.fm) in a new tab — the same link everywhere, in-game too.
// Six buttons → .efm-actions (global.css) lays them out 2×3, 3×2 or 6×1 so
// no button is ever left alone on a row; the column count follows the row's
// own width (container query) so labels don't wrap.
import { site } from '../site.config';
---

<section class="pt-2 efm-actions-wrap">
  <div class="efm-actions">
    <button type="button" id="open-request" class="btn btn-sunburst">Request a song</button>
    <a href="/player/" id="open-player" class="btn btn-player"><span class="btn-player-dot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>Web Player</a>
    <a href={site.music.portalUrl} target="_blank" rel="noopener" id="open-music" class="btn btn-midnight">{site.music.button}</a>
    <a href="/events" id="open-events" class="btn btn-events">Events</a>
    <button type="button" id="open-contact" class="btn btn-ruby">Contact us</button>
    <button type="button" id="open-business" class="btn btn-mixed">Business AD</button>
  </div>
</section>

<script is:inline>
  (function () {
    // View Transitions API wrapper — falls back to a plain dispatch on browsers
    // that don't support it. Either way the event fires; the API just adds a
    // smooth crossfade on supporting browsers.
    const fire = (name) => {
      const dispatch = () => document.dispatchEvent(new CustomEvent(name));
      if (typeof document.startViewTransition === 'function') {
        document.startViewTransition(dispatch);
      } else {
        dispatch();
      }
    };

    document.getElementById('open-request')?.addEventListener('click', () => fire('efm:open-request'));
    document.getElementById('open-contact')?.addEventListener('click', () => fire('efm:open-contact'));
    document.getElementById('open-business')?.addEventListener('click', () => fire('efm:open-business'));

    // Shared close: any element with data-close="<overlay-id>" closes that overlay.
    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-close]');
      if (!el) return;
      const id = el.getAttribute('data-close');
      const overlay = id ? document.getElementById(id) : null;
      if (!overlay) return;
      const doClose = () => { overlay.classList.add('hidden'); overlay.setAttribute('aria-hidden', 'true'); };
      if (typeof document.startViewTransition === 'function') {
        document.startViewTransition(doClose);
      } else {
        doClose();
      }
    });

    // Escape key closes any open overlay.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      ['request-overlay', 'contact-overlay', 'business-overlay'].forEach((id) => {
        const o = document.getElementById(id);
        if (o && !o.classList.contains('hidden')) {
          o.classList.add('hidden');
          o.setAttribute('aria-hidden', 'true');
        }
      });
    });
  })();
</script>
