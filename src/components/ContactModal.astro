---
import { site } from '../site.config';
---

<div id="contact-overlay" class="hidden fixed inset-0 z-[70] bg-ink/80 backdrop-blur-sm" aria-hidden="true">
  <div class="mx-auto max-w-md w-full h-full flex flex-col py-4 px-4 lg:py-10">
    <div class="card efm-modal-enter !p-4 flex-1 overflow-y-auto lg:max-h-[80vh]">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-base font-bold text-ruby">Contact us</h2>
        <button type="button" class="efm-close-btn" data-close="contact-overlay" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>
      <p class="text-xs text-cream/60 mb-3">Send a message to the EuphoricFM team.</p>

      <form id="contact-form" novalidate class="space-y-2.5">
        <div><label class="label">Your Name <span class="text-ruby">*</span></label><input class="input" name="name" maxlength="100" required placeholder="e.g., Wyatt McKenzie" /></div>
        <div><label class="label">Phone (optional)</label><input class="input" name="phone" maxlength="40" type="tel" placeholder="Optional" /></div>
        <div><label class="label">NewDayRP Profile (optional)</label><input class="input" name="profile" maxlength="200" type="url" placeholder="https://newdayrp.com/members/9631/" /></div>
        <div><label class="label">Subject <span class="text-ruby">*</span></label><input class="input" name="subject" maxlength="200" required placeholder="What's this about?" /></div>
        <div><label class="label">Message <span class="text-ruby">*</span></label><textarea class="input min-h-[110px]" name="message" maxlength="4000" required placeholder="Write your message here…"></textarea></div>

        <div id="contact-msg" class="hidden text-xs px-3 py-2 rounded-lg"></div>

        <div class="pt-2 flex gap-2">
          <button type="button" class="btn flex-1 bg-cream/10 text-cream" data-close="contact-overlay">Cancel</button>
          <button type="submit" id="contact-go" class="btn flex-1 btn-ruby">Send</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script is:inline define:vars={{ profilePattern: site.newDayRpProfilePattern }}>
  // Sends the form fields to the same-origin relay (/contact/message, the
  // efm-requests sidecar), which builds the team's message and holds the
  // delivery URL server-side — nothing secret ever reaches the page.
  (function () {
    const overlay = document.getElementById('contact-overlay');
    const form = document.getElementById('contact-form');
    const msg = document.getElementById('contact-msg');
    const go = document.getElementById('contact-go');
    if (!overlay || !form || !msg || !go) return;

    const setMsg = (text, kind) => {
      msg.textContent = text;
      msg.className = 'text-xs px-3 py-2 rounded-lg ' +
        (kind === 'error' ? 'bg-ruby/15 text-ruby border border-ruby/30' : 'bg-sunburst/15 text-sunburst border border-sunburst/30');
      msg.classList.remove('hidden');
    };

    const profileRe = new RegExp(profilePattern, 'i');

    // "Please wait" copy for a 429: the relay says how long in retry_after.
    const waitText = async (r) => {
      const j = await r.json().catch(() => ({}));
      const s = Number(j.retry_after) || Number(r.headers.get('retry-after')) || 0;
      const when = s > 90 ? `about ${Math.ceil(s / 60)} minutes` : s > 0 ? `${s} seconds` : 'a few minutes';
      return `You've sent a few messages already — please wait ${when} and try again.`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');
      const data = Object.fromEntries(new FormData(form).entries());
      const name = String(data.name || '').trim();
      const phone = String(data.phone || '').trim();
      const profile = String(data.profile || '').trim();
      const subject = String(data.subject || '').trim();
      const message = String(data.message || '').trim();

      if (!name || !subject || !message) { setMsg('Please fill in: Your name, Subject, and Message.', 'error'); return; }
      if (profile && !profileRe.test(profile)) {
        setMsg('Profile must be a valid NewDayRP link like https://newdayrp.com/members/9631/', 'error'); return;
      }

      go.setAttribute('disabled', 'true');

      try {
        const r = await fetch('/contact/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, profile, subject, message }),
        });
        if (r.ok) {
          setMsg('Thanks! Your message was sent.', 'ok');
          form.reset();
          setTimeout(() => { overlay.classList.add('hidden'); msg.classList.add('hidden'); }, 1200);
        } else if (r.status === 429) {
          setMsg(await waitText(r), 'error');
        } else if (r.status === 503) {
          setMsg('Messages are temporarily disabled. Please try again later.', 'error');
        } else if (r.status === 400 || r.status === 413) {
          setMsg('Something in the form was not accepted (too long?). Please check it and try again.', 'error');
        } else {
          setMsg(`Failed to send (HTTP ${r.status}).`, 'error');
        }
      } catch (err) {
        console.warn('[efm] contact failed', err);
        setMsg('Network error while sending.', 'error');
      } finally {
        go.removeAttribute('disabled');
      }
    });

    document.addEventListener('efm:open-contact', () => {
      overlay.classList.remove('hidden');
      overlay.setAttribute('aria-hidden', 'false');
    });
  })();
</script>
