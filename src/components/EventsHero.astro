---
// /events page hero — eyebrow + heading + body + a Listen link. Requests live
// at events.euphoric.fm now, so there is no inquiry button here.
import { site } from '../site.config';
const h = site.events.hero;
---

<section class="section">
  <div class="card">
    <div class="flex items-center gap-2">
      <span class="efm-eq text-sunburst" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      <span class="text-[10px] uppercase tracking-widest text-gold">{h.eyebrow}</span>
    </div>
    <h2 class="mt-2 font-bold text-cream leading-tight" style="font-size: clamp(1.375rem, 3.5vw, 2rem);">{h.heading}</h2>
    <p class="mt-2 text-sm lg:text-base text-cream/75 leading-relaxed">{h.body}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <a href="/" class="btn btn-midnight">{h.ctaListen}</a>
    </div>
  </div>
</section>

