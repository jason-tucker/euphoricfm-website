# events-web (events.euphoric.fm). mode 600, owner botuser. compose.yml sets
# PORTAL_SITE=events itself. Holds NO AzuraCast key and NO tickets key of
# either portal: events-web refuses to start if it sees AZURACAST_API_KEY,
# TICKETS_WRITE_KEY, EVENTS_AZURACAST_API_KEY or EVENTS_TICKETS_WRITE_KEY.
#
# MUST EQUAL music's web.env (same DB rows, same Discord app, same encrypted
# `account` tokens that both webs read and refresh):
#   DATABASE_URL, AUTH_DISCORD_ID, AUTH_DISCORD_SECRET, APP_ENC_KEY,
#   DISCORD_GUILD_ID, PORTAL_OWNER_IDS
# MUST DIFFER from music's web.env:
#   PORTAL_ORIGIN / AUTH_URL (events origin), AUTH_SECRET (its own),
#   TICKETS_WEBHOOK_SECRET (random, never registered anywhere),
#   TICKETS_GUILD_READ_KEY (empty: no guild:read key in v1)
DATABASE_URL=postgres://music_app:replace-with-music-app-password@music-db:5432/music
PORTAL_ORIGIN=https://events.euphoric.fm
AUTH_URL=https://events.euphoric.fm
# Its OWN secret (openssl rand -base64 33), never music's: the two sites'
# session cookies must not validate on each other.
AUTH_SECRET=replace-with-a-new-random-secret
# Same Discord application "EFM Music" as music-web. Add
# https://events.euphoric.fm/api/auth/callback/discord to its OAuth2 redirects.
AUTH_DISCORD_ID=replace-with-the-music-client-id
AUTH_DISCORD_SECRET=replace-with-the-music-client-secret
# SAME value as music-web (both decrypt the same account tokens).
APP_ENC_KEY=replace-with-the-music-app-enc-key
DISCORD_GUILD_ID=915830850694815765
PORTAL_OWNER_IDS=117501528641634310
# No inbound tickets webhook and no guild:read key in v1. The schema still
# requires a webhook secret (>= 32 chars): a random value used nowhere
# (openssl rand -hex 32). An empty read key means sign-in relies on Discord's
# own member lookup only (if it errors, sign-in says "try again").
TICKETS_API_BASE=http://tickets-web:3000
TICKETS_GUILD_READ_KEY=
TICKETS_WEBHOOK_SECRET=replace-with-random-unused-secret-of-64-hex
# Never set any EVENTS_* key here.
