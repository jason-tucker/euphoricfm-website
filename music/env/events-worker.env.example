# events-worker (claims only event_jobs; drives the Events station 14).
# mode 600, owner botuser. The ONLY holder of the events AzuraCast key and the
# efm-events tickets key. Refuses to start if it sees the music keys
# (AZURACAST_API_KEY, TICKETS_WRITE_KEY) or any web secret (AUTH_SECRET,
# AUTH_DISCORD_SECRET, APP_ENC_KEY, TICKETS_GUILD_READ_KEY,
# TICKETS_WEBHOOK_SECRET, owner DB credentials).
#
# MUST EQUAL music's worker.env: DATABASE_URL, AZURACAST_BASE_URL,
# TICKETS_API_BASE.
DATABASE_URL=postgres://music_app:replace-with-music-app-password@music-db:5432/music
AZURACAST_BASE_URL=https://euphoric.fm
# Must be 14 (the Events station); anything else refuses to start.
EVENTS_STATION_ID=14
# AzuraCast API key for the events worker. Since 2026-09-29 events and music
# share ONE AzuraCast account (music-portal@euphoric.fm, role 9, which
# manages stations 1 and 14); use an API key of that account created for the
# events worker, not the string in music's worker.env. Isolation from
# station 1 is in code: the events wrapper only ever drives station 14.
EVENTS_AZURACAST_API_KEY=replace-with-events-azuracast-key
# Start-up self-check: every station listed here must answer 403 to the
# events key. 7 only (it proves the key is not a superadmin key): with the
# shared account station 1 answers 200, so it can NOT be listed here.
# Must not contain 14.
EVENTS_CANARY_STATION_IDS=7
# Tickets integration "efm-events": scopes tickets:write + tickets:close,
# allowedCategoryKeys ['eventrequest'], no actor impersonation, link origin
# https://events.euphoric.fm. NEVER the efm-music key.
TICKETS_API_BASE=http://tickets-web:3000
EVENTS_TICKETS_WRITE_KEY=replace-with-efm-events-key
PORTAL_ORIGIN=https://events.euphoric.fm
# Optional: also post alerts (failed start kick, dead job, failed key
# self-check) to this Discord webhook, like music's worker.env.
# ALERT_DISCORD_WEBHOOK=
