# music-migrate (one-shot). mode 600, owner botuser.
DATABASE_OWNER_URL=postgres://music_owner:replace-with-db-owner-password@music-db:5432/music
# Password for the least-privilege runtime role music_app ([A-Za-z0-9_-+/=.], 24-128 chars).
# The same value goes into DATABASE_URL in web.env and worker.env.
MUSIC_APP_DB_PASSWORD=replace-with-openssl-rand-hex-24
# Reviewer roles (review + manage), seeded ONCE into role_bindings:
# EFM - Manager, Euphoric Board, EFM - Staff
SEED_REVIEW_ROLE_IDS=1144462744456794153,917525862696489001,1145243342620327947
