# music-worker. mode 600, owner botuser. The ONLY holder of the AzuraCast key
# and the tickets write key.
DATABASE_URL=postgres://music_app:replace-with-music-app-password@music-db:5432/music
# Profile guard (plan §3.7 as amended): 'prod' or 'test'; both require STATION_ID=1.
MUSIC_PROFILE=prod
STATION_ID=1
# Set for the first live verifications: every write path must start with it.
# Remove only after the Deploy-1 and P3 live checks pass. Required when MUSIC_PROFILE=test.
PORTAL_TEST_PREFIX=Portal-Test/
AZURACAST_BASE_URL=https://euphoric.fm
# Production key: user 18 music-portal@euphoric.fm, role 9, station 1 media only.
AZURACAST_API_KEY=replace-with-azuracast-key
# Startup self-check expects this station to answer 403 (proves the key is not super-admin).
AZURACAST_CANARY_STATION_ID=7
# More stations the key must NOT reach (each must answer 403 at start-up and
# in the daily re-check). Default 14 (Events, shares storage 2).
# AZURACAST_EXTRA_CANARY_STATION_IDS=14
PORTAL_ORIGIN=https://music.euphoric.fm
# Tickets Integration API over efm-public-net; key scopes tickets:read/write/close + actor_impersonation.
TICKETS_API_BASE=http://tickets-web:3000
TICKETS_WRITE_KEY=replace-with-efm-music-key
# Optional alert sinks for contract drift / dead jobs
# KUMA_PUSH_URL=
# ALERT_DISCORD_WEBHOOK=
# P3 (optional): Kuma push monitor for staging disk use (up < 85 %, down >= 85 %); unset = no push.
# KUMA_DISK_PUSH_URL=
# P3 (optional, only with PORTAL_TEST_PREFIX): an existing media file under
# PORTAL_TEST_PREFIX/Music/Artists/ for the start-up + daily behavioural
# /files/batch contract check (a no-op playlist re-apply). Unset = check skipped and logged.
# PORTAL_CONTRACT_FIXTURE=Portal-Test/Music/Artists/Portal Contract/fixture.mp3
