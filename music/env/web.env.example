# music-web. mode 600, owner botuser. Holds NO AzuraCast key and NO tickets:*
# key; web refuses to start if it sees AZURACAST_API_KEY / TICKETS_WRITE_KEY.
DATABASE_URL=postgres://music_app:replace-with-music-app-password@music-db:5432/music
PORTAL_ORIGIN=https://music.euphoric.fm
AUTH_URL=https://music.euphoric.fm
# openssl rand -base64 33
AUTH_SECRET=replace-with-random-secret
# Discord application "EFM Music" (scopes: identify guilds.members.read)
AUTH_DISCORD_ID=replace-with-client-id
AUTH_DISCORD_SECRET=replace-with-client-secret
# 32 bytes, base64 or 64 hex (openssl rand -base64 32). Encrypts OAuth tokens at rest.
APP_ENC_KEY=replace-with-32-byte-key
DISCORD_GUILD_ID=915830850694815765
# admin comes ONLY from here (comma-separated Discord user ids)
PORTAL_OWNER_IDS=117501528641634310
# Tickets Integration API over efm-music-hooks: the WEB key has guild:read ONLY.
TICKETS_API_BASE=http://tickets-web:3000
TICKETS_GUILD_READ_KEY=replace-with-efm-music-web-key
# Webhook secret shown once on tickets /admin/integrations (>= 32 chars).
TICKETS_WEBHOOK_SECRET=replace-with-webhook-secret
# Optional, only during a secret rotation:
# TICKETS_WEBHOOK_SECRET_PREVIOUS=
# Optional: while the worker runs with PORTAL_TEST_PREFIX (first live
# verifications), set the same value here so requests target that tree.
# PORTAL_TEST_PREFIX=Portal-Test/
