{
  "name": "efm-music-portal",
  "private": true,
  "version": "0.3.6",
  "description": "EFM Music Portal (music.euphoric.fm): Discord-gated music submission and review. Separate package from the Astro site; its own lockfile and Docker targets (web, worker, probe, fetch).",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/bundle.mjs",
    "build:web": "next build",
    "build:bundles": "node scripts/bundle.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.5",
    "drizzle-orm": "0.45.3",
    "music-metadata": "11.16.1",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "node-id3": "0.2.9",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tus-js-client": "4.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23"
    }
  }
}
