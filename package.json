    "test:site": "node --test test/*.test.mjs",
    "sync:shared": "node shared/sync.mjs"
  },
  "dependencies": {
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
