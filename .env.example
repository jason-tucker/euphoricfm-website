# euphoricfm-website — environment template
#
# Copy to .env and adjust. .env is gitignored.

# Image pulled by watchtower from GHCR. CI publishes :latest on every merge to main.
IMAGE=ghcr.io/jason-tucker/euphoricfm-website:latest

# Loopback port Caddy binds to on the host. Cloudflared (standalone on the
# host) reaches us at 127.0.0.1:${PORT}. NEVER expose to 0.0.0.0.
PORT=6094

# Public URL — used for canonical/og:url. Override per environment.
PUBLIC_BASE_URL=https://info.euphoric.fm

# Discord webhook for the "Contact us" form and the /events inquiry form.
# Only the efm-requests container reads it: the forms post to the same-origin
# /contact/* relay, which builds the message and forwards it here, so the URL
# never reaches visitors. Empty = both forms answer "temporarily disabled".
# Get it from the Discord channel's Integrations → Webhooks. It is a
# credential (anyone holding it can post as, rename or delete the webhook):
# NEVER commit a real value, never paste it in chat or logs. After changing it
# run `docker compose up -d efm-requests` (a restart keeps the old value).
# (PUBLIC_DISCORD_CONTACT_WEBHOOK and PUBLIC_DISCORD_REQUEST_WEBHOOK are gone:
# nothing reads them since v0.22.3 / the music portal; delete them from .env.)
DISCORD_CONTACT_WEBHOOK=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Station stats (server/stats.mjs, served at /stats/* by efm-requests).
# AzuraCast's history endpoint is auth-only — create this key in AzuraCast
# under My Account → API Keys (or an admin key) with the station's
# reports/history permission, then paste it here to enable full-time
# backfill (back to STATS_BACKFILL_START). Leave empty and stats still work:
# they accumulate live from the 30s nowplaying poll, just with no history
# older than first boot. NEVER commit a real key — the key stays server-side
# and is never exposed to visitors.
AZURACAST_API_KEY=

# Set to any new value (e.g. a timestamp) + `docker compose up -d` to wipe
# play-derived stats and re-backfill from scratch (listener sample data is
# kept). Leave empty in normal operation.
STATS_BACKFILL_RESET=

# Playlists whose plays never count toward stats (ads/IDs), comma-separated,
# case-insensitive exact names. Leave empty for the built-in default:
# 2Ads,3EFM/Free Ads,5Local Ads,Go Vote,4EuphoricFM
STATS_EXCLUDE_PLAYLISTS=
